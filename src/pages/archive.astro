---
import ArchivePanel from "@components/ArchivePanel.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPostsList, getCategoryList, getTagList} from "../utils/content-utils";

const sortedPostsList = await getSortedPostsList();
const categories = await getCategoryList();
const tags = await getTagList();

const categoryNames = categories.map(c => c.name);
const tagNames = tags.map(t => t.name);

const safePosts = sortedPostsList.map(post => ({
    ...post,
    data: {
        ...post.data,
        category: post.data.category ?? undefined
    }
}));

---

<MainGridLayout title={i18n(I18nKey.archive)}>
    #<ArchivePanel tags={tags as any} categories={categories as any} sortedPosts={sortedPostsList as any} client:only="svelte"></ArchivePanel>
    <ArchivePanel 
        tags={tagNames} 
        categories={categoryNames} 
        sortedPosts={safePosts} 
        client:only="svelte"
    ></ArchivePanel>
</MainGridLayout>

